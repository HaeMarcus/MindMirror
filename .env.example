# MindMirror 环境变量配置
# 复制此文件为 .env，填入真实值

# =====================
# 必填
# =====================

# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =====================
# 可选
# =====================

# Claude API 代理地址（国内加速，留空使用官方地址）
# 例如：https://api.anthropic-proxy.example.com
ANTHROPIC_BASE_URL=

# 允许额外的 CORS 来源（如有自定义域名填入，否则留空）
# 例如：https://mindmirror.yourdomain.com
CORS_ORIGIN=

# 开发者统计接口令牌。留空时 /api/analytics 与 /api/feedback/stats 返回 404。
# 查询时通过 X-Admin-Token 请求头传入；不要提交真实值到仓库。
ADMIN_TOKEN=
